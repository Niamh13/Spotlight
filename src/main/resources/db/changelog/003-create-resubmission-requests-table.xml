<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.27.xsd">

    <changeSet id="003-create-resubmission-requests-table" author="team">
        <createTable tableName="resubmission_requests">
            <column name="id" type="UUID">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="nomination_id" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="recipient_email" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <!-- Null until Epic 3 introduces coordinator accounts. -->
            <column name="requested_by_email" type="VARCHAR(255)"/>
            <!-- The message as sent, kept verbatim - the criteria are re-evaluated on
                 every read, so this column is the only record of what was actually said. -->
            <column name="message" type="CLOB">
                <constraints nullable="false"/>
            </column>
            <column name="sent_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addForeignKeyConstraint
                baseTableName="resubmission_requests"
                baseColumnNames="nomination_id"
                referencedTableName="nominations"
                referencedColumnNames="id"
                constraintName="fk_resubmission_requests_nomination"/>

        <createIndex tableName="resubmission_requests" indexName="idx_resubmission_requests_nomination">
            <column name="nomination_id"/>
        </createIndex>

        <rollback>
            <dropIndex tableName="resubmission_requests" indexName="idx_resubmission_requests_nomination"/>
            <dropForeignKeyConstraint baseTableName="resubmission_requests"
                                       constraintName="fk_resubmission_requests_nomination"/>
            <dropTable tableName="resubmission_requests"/>
        </rollback>
    </changeSet>

</databaseChangeLog>

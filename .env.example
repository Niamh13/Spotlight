# Template for local secrets. This file IS committed; .env is not.
#
# Setup:
#   cp .env.example .env      (Mac/Linux)
#   copy .env.example .env    (Windows)
# then fill in the values below.
#
# The app runs fine without any of this. Leave GROQ_API_KEY empty and the
# built-in mock evaluator takes over: nominations still get scores, rationales
# and flags, so a fresh clone is testable immediately. Add a key only when you
# want the real model.

# Groq API key, from console.groq.com. Free tier, no card required.
GROQ_API_KEY=

# MySQL. Defaults to root/root on localhost:3306 (see application.properties) -
# only set these if your local MySQL uses different credentials.
MYSQL_USERNAME=
MYSQL_PASSWORD=

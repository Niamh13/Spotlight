<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.0</version>
        <relativePath/>
    </parent>

    <groupId>com.version1</groupId>
    <artifactId>recognition-platform</artifactId>
    <version>0.1.0</version>
    <name>recognition-platform</name>
    <description>Star Award nomination review engine - Phase 1 prototype</description>

    <properties>
        <java.version>17</java.version>
        <cucumber.version>7.18.1</cucumber.version>
        <!-- Placeholder local defaults for the standalone liquibase-maven-plugin
             below (mvn liquibase:update/rollback and the dropAll binding) -
             override with -Dmysql.username=... -Dmysql.password=... rather than
             editing these, so a real credential never lands in this committed
             file. The app itself reads MYSQL_USERNAME/MYSQL_PASSWORD env vars
             instead (see application*.properties) - these two are only for the
             plugin's own classloader, which can't see env-var placeholders the
             same way. -->
        <mysql.username>root</mysql.username>
        <mysql.password>root</mysql.password>
        <!-- Spring Boot 3.3.0 pins Byte Buddy 1.14.16, which cannot instrument
             classes on JDK 26 - every Mockito test errors with "Mockito cannot
             mock this class" before a single assertion runs. Overriding the
             version lets the suite run on modern JDKs; it changes nothing about
             the code under test. -->
        <byte-buddy.version>1.17.5</byte-buddy.version>
    </properties>

    <!-- Every dependency below carries a note saying what it gives us and why it
         is here. Anything without a reason should be deleted, not inherited. -->
    <dependencies>

        <!-- Health endpoint at /actuator/health. Cheap way to answer "is it
             actually up?" without loading a page. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- The web server plus Spring MVC. This is what turns the annotated
             classes in nomination/web into a REST API, and what serves the
             built front end out of resources/static. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- JPA and Hibernate. Maps the Nomination entity to database rows and
             turns the repository interfaces into working queries, so there is
             no hand-written SQL anywhere outside the Liquibase migrations. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!-- Bean Validation: the @NotBlank / @Email annotations on
             NominationRequest. Bad input is rejected before any of our code
             runs, which keeps the field checks in one place rather than
             scattered through the service. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- The database driver. MySQL needs a real server (see .env/docker-compose
             for local setup); runtime scope because no code imports it, only the
             JDBC URL names it. -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Version control for the database schema. The 11 files in
             db/changelog are applied in order and recorded, so every machine
             ends up with the same tables and the seed data arrives with them.
             Without this the schema would only exist in whoever's H2 file. -->
        <dependency>
            <groupId>org.liquibase</groupId>
            <artifactId>liquibase-core</artifactId>
        </dependency>

        <!-- Reads a gitignored .env file at startup so secrets can sit beside the
             project instead of in a machine-level environment variable. Spring
             Boot has no native .env support - it isn't a Node app - so this is
             the small, well-established way to get it. This is the only
             third-party (non-Spring, non-Apache) dependency in the project. -->
        <dependency>
            <groupId>me.paulschwarz</groupId>
            <artifactId>spring-dotenv</artifactId>
            <version>4.0.0</version>
        </dependency>

        <!-- JUnit 5, Mockito and AssertJ in one starter - what
             NominationServiceTest is written against. Test scope, so none of it
             ships in the built jar. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- UAT tier: business-readable acceptance criteria as Gherkin, run
             through the same JUnit 5 platform as everything else in
             src/test/java (see uat/RunCucumberTest.java). -->
        <dependency>
            <groupId>io.cucumber</groupId>
            <artifactId>cucumber-java</artifactId>
            <version>${cucumber.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.cucumber</groupId>
            <artifactId>cucumber-spring</artifactId>
            <version>${cucumber.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.cucumber</groupId>
            <artifactId>cucumber-junit-platform-engine</artifactId>
            <version>${cucumber.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.platform</groupId>
            <artifactId>junit-platform-suite</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <!-- Lets migrations run standalone via `mvn liquibase:update` / `mvn liquibase:rollback`,
                 independent of starting the whole app - what this story actually needs. -->
            <plugin>
                <groupId>org.liquibase</groupId>
                <artifactId>liquibase-maven-plugin</artifactId>
                <version>4.27.0</version>
                <configuration>
                    <changeLogFile>src/main/resources/db/changelog/db.changelog-master.xml</changeLogFile>
                    <url>jdbc:mysql://localhost:3306/recognitiondb?createDatabaseIfNotExist=true&amp;useSSL=false&amp;allowPublicKeyRetrieval=true&amp;serverTimezone=UTC</url>
                    <driver>com.mysql.cj.jdbc.Driver</driver>
                    <username>${mysql.username}</username>
                    <password>${mysql.password}</password>
                </configuration>
                <executions>
                    <!-- The black-box/UAT tier shares one cached Spring context (and DB)
                         across the whole test run - unlike H2's old in-memory instance,
                         a persistent MySQL server keeps row data between `mvn test` runs.
                         This drops and lets Spring Boot's own Liquibase run recreate the
                         blackbox schema fresh, once, before tests start - the MySQL
                         equivalent of the old jdbc:h2:mem:...;DB_CLOSE_DELAY=-1 behavior. -->
                    <execution>
                        <id>reset-blackbox-database</id>
                        <phase>process-test-classes</phase>
                        <goals>
                            <goal>dropAll</goal>
                        </goals>
                        <configuration>
                            <url>jdbc:mysql://localhost:3306/recognitiondb_blackbox?createDatabaseIfNotExist=true&amp;useSSL=false&amp;allowPublicKeyRetrieval=true&amp;serverTimezone=UTC</url>
                            <driver>com.mysql.cj.jdbc.Driver</driver>
                            <username>${mysql.username}</username>
                            <password>${mysql.password}</password>
                        </configuration>
                    </execution>
                </executions>
                <!-- Maven plugins run on their own classloader, not the project's -
                     the driver has to be declared here too, or both this dropAll
                     execution and standalone `mvn liquibase:update`/`rollback` fail
                     to find com.mysql.cj.jdbc.Driver. -->
                <dependencies>
                    <dependency>
                        <groupId>com.mysql</groupId>
                        <artifactId>mysql-connector-j</artifactId>
                        <!-- Matches the version spring-boot-starter-parent:3.3.0's BOM
                             manages for the project's own runtime dependency above -
                             confirmed via `mvn dependency:tree -Dincludes=com.mysql:mysql-connector-j`. -->
                        <version>8.3.0</version>
                    </dependency>
                </dependencies>
            </plugin>
        </plugins>
    </build>
</project>
